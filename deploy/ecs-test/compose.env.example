# Copy outside the repository to a restricted file; placeholders are intentionally not usable.
ZZSH_TEST_IMAGE_TAG=REPLACE_WITH_REVIEWED_REVISION
ZZSH_TEST_USER_DOMAIN=test.nanproduced.cloud
ZZSH_TEST_ADMIN_DOMAIN=admin-test.nanproduced.cloud
ZZSH_TEST_API_DOMAIN=api-test.nanproduced.cloud
ZZSH_TEST_ACME_EMAIL=REPLACE_WITH_CERTIFICATE_CONTACT
ZZSH_TEST_SECRETS_DIR=/srv/zzsh-test/secrets
ZZSH_TEST_API_ENV_FILE=/srv/zzsh-test/api.env
# Choose three non-overlapping subnets that do not conflict with the ECS/VPC routes.
# If changed, update each corresponding static address together.
ZZSH_TEST_WEB_SUBNET=172.30.240.0/28
ZZSH_TEST_PROXY_WEB_IP=172.30.240.2
ZZSH_TEST_WEB_EDGE_IP=172.30.240.3
ZZSH_TEST_APP_SUBNET=172.30.241.0/28
ZZSH_TEST_PROXY_APP_IP=172.30.241.2
ZZSH_TEST_WEB_APP_IP=172.30.241.3
ZZSH_TEST_API_APP_IP=172.30.241.4
ZZSH_TEST_DATA_SUBNET=172.30.242.0/28
ZZSH_TEST_API_DATA_IP=172.30.242.2
ZZSH_TEST_PG_IP=172.30.242.3
ZZSH_TEST_REDIS_IP=172.30.242.4
