# Dependencies and generated outputs
node_modules/
dist/
build/
.next/
out/
coverage/
.turbo/
*.tsbuildinfo
*.log
test-results/
playwright-report/

# Local secrets (templates must contain placeholders only)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.jks

# Legacy evidence, runtime files and local references: never import wholesale
/.archive/
/analysis/
/reports/
/legacy-local/
/uploads/
/backups/
*.jar
*.class
*.dump
*.sql.gz
*.zip

# Tool / editor / OS local state
.rtk/
.idea/
.vscode/
# Local Windows junctions generated by the skills installer; canonical skills live in .agents
/.claude/skills/
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# Serena: keep child project configuration, not local state
**/.serena/*
!apps/admin/.serena/project.yml
!apps/api/.serena/project.yml
!apps/web/.serena/project.yml
