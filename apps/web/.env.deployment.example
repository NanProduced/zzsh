# Next服务端环境，由服务管理器注入；不含数据库、商户或云服务秘密。
NODE_ENV=production
ZZSH_API_ORIGIN=https://api.REPLACE_WITH_TEST_DOMAIN
ZZSH_WEB_ORIGIN=https://www.REPLACE_WITH_TEST_DOMAIN
# SEO 收录开关：仅生产填 1，测试环境不配置或留 0；为 1 时 ZZSH_WEB_ORIGIN 必须是合法 https origin。
ZZSH_SEO_INDEXABLE=0
# 仅当Next只经受控反代可达、反代已清理并覆写客户端头时使用。
USER_EDGE_ASSURED=true
USER_TRUSTED_PROXIES=loopback
