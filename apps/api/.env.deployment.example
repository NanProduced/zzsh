# 部署模板：由服务管理器注入，不会被API自动读取；先替换占位项，勿写入实际密钥。
# 线上团队测试使用ecs-test，正式上线改production；库名相应使用zzsh_ecs_test*/zzsh_prod*。
NODE_ENV=production
APP_PROFILE=ecs-test
PROVIDER_MODE=real
HOST=127.0.0.1
PORT=3102
DB_TARGET=ecs-test
DB_HOST=REPLACE_WITH_PRIVATE_PG_HOST
DB_PORT=5432
DB_NAME=zzsh_ecs_test
DB_USER=zzsh_runtime
DB_PASSWORD_FILE=.secrets/runtime_db_password
DB_TLS_MODE=verify-full
DB_TLS_CA_FILE=.secrets/postgresql-ca.pem
REDIS_HOST=REPLACE_WITH_PRIVATE_REDIS_HOST
REDIS_PORT=6379
REDIS_USER=zzsh_app
REDIS_PASSWORD_FILE=.secrets/redis_password
REDIS_TLS_MODE=verify-full
REDIS_TLS_CA_FILE=.secrets/redis-ca.pem

AUTH_API_ORIGIN=https://api.REPLACE_WITH_TEST_DOMAIN
AUTH_USER_ORIGIN=https://www.REPLACE_WITH_TEST_DOMAIN
AUTH_ADMIN_ORIGIN=https://admin.REPLACE_WITH_TEST_DOMAIN
AUTH_SECURE_COOKIES=true
AUTH_USER_SECRET_FILE=.secrets/auth_user_secret
AUTH_ADMIN_SECRET_FILE=.secrets/auth_admin_secret
ADMIN_ALTCHA_HMAC_KEY_FILE=.secrets/admin_altcha_hmac
USER_AUTH_THROTTLE_HMAC_KEY_FILE=.secrets/user_auth_throttle_hmac
USER_IDENTITY_SUBJECT_HMAC_KEY_FILE=.secrets/user_identity_subject_hmac
USER_AUTH_THROTTLE_STORE=postgres
USER_AUTH_THROTTLE_MODE=base
# 按实际反代链设置；不可把任意客户端来源都列为可信。
ADMIN_TRUSTED_PROXIES=loopback
ADMIN_CLIENT_IP_HEADER=x-real-ip
USER_TRUSTED_PROXIES=loopback
USER_EDGE_ASSURED=true

ORDER_CONFIRMATION_KEY_ID=order-confirmation-v1
ORDER_CONFIRMATION_SECRET_FILE=.secrets/order_confirmation_secret
LISTING_CURSOR_KEY_ID=listing-cursor-v1
LISTING_CURSOR_SECRET_FILE=.secrets/listing_cursor_secret

MEDIA_STORAGE=oss
OSS_BUCKET=REPLACE_WITH_TEAM_TEST_BUCKET
OSS_REGION=oss-cn-REPLACE
OSS_ENDPOINT=https://oss-cn-REPLACE.aliyuncs.com
OSS_OBJECT_PREFIX=zzsh/team-test/media/
# OSS现适配器从进程凭据ALIBABA_CLOUD_ACCESS_KEY_ID/SECRET及可选SECURITY_TOKEN读取；
# 不把实际值写在这里。当前静态STS无自动续期，部署前须落实持续凭据供应。

USER_SMS_PROVIDER=aliyun
USER_SMS_SIGN_NAME=REPLACE_WITH_APPROVED_SIGN
USER_SMS_TEMPLATE_CODE=REPLACE_WITH_APPROVED_TEMPLATE
USER_SMS_ACCESS_KEY_ID_FILE=.secrets/user_sms_access_key_id
USER_SMS_ACCESS_KEY_SECRET_FILE=.secrets/user_sms_access_key_secret
USER_REAL_NAME_PROVIDER=aliyun-id2meta
USER_REAL_NAME_ACCESS_KEY_ID_FILE=.secrets/user_real_name_access_key_id
USER_REAL_NAME_ACCESS_KEY_SECRET_FILE=.secrets/user_real_name_access_key_secret
USER_REAL_NAME_DAILY_LIMIT=REPLACE_WITH_APPROVED_LIMIT
USER_REAL_NAME_MIN_INTERVAL_SECONDS=REPLACE_WITH_APPROVED_SECONDS

YUNXIN_APP_KEY=REPLACE_WITH_TEST_APP_KEY
YUNXIN_APP_SECRET_FILE=.secrets/yunxin_app_secret
ORDER_TEAMS_MEMBERS_LIMIT=REPLACE_WITH_APPROVED_TEAM_CAPACITY
# 云信85等Owner暂缓能力不在模板自动开启；App控制台回调与签名另行配置核验。

# 这些是第三方渠道装配，不是内部业务开关；配置须绑定准确资源、商户/产品、原号与版本。
JOINPAY_COLLECTION_ENABLED=true
JOINPAY_COLLECTION_CONFIG_FILE=.secrets/joinpay_collection.json
JOINPAY_REFUND_ENABLED=true
JOINPAY_REFUND_CONFIG_FILE=.secrets/joinpay_refund.json
JOINPAY_PAYOUT_ENABLED=true
JOINPAY_PAYOUT_CONFIG_FILE=.secrets/joinpay_payout.json
JOINPAY_ACCOUNTS_ENABLED=true
JOINPAY_ACCOUNTS_CONFIG_FILE=.secrets/joinpay_accounts.json
WITHDRAWAL_BANK_BINDING_ENABLED=true
WITHDRAWAL_BANK_BINDING_CONFIG_FILE=.secrets/withdrawal_bank_binding.json
# 上述JSON仅引用各领域版本化钥的环境名或_FILE；见deployment-prerequisites.md。
# 暂停新请求使用JSON内newRequestsEnabled/newRefundsEnabled等，不删除历史QUERY/NOTIFY配置。
# 不再配置AUTH_ENABLED/成长/信用/结算/分销/分发启停：部署环境默认装配且拒绝false。
