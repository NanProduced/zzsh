# Copy to .env locally and create the two ignored files under .secrets/.
APP_PROFILE=dev
PROVIDER_MODE=fake
DB_TARGET=local-compose
HOST=127.0.0.1
PORT=3102
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=zzsh_dev
DB_USER=zzsh
DB_PASSWORD_FILE=.secrets/postgres_password
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_PASSWORD_FILE=.secrets/redis_password

# Authentication is opt-in for local startup until the business migration has been run.
# AUTH_ENABLED=true additionally requires DB_USER/DB_PASSWORD to be a non-owner runtime role;
# the compose bootstrap owner `zzsh` is not an application runtime identity.
AUTH_ENABLED=false
AUTH_API_ORIGIN=http://127.0.0.1:3102
AUTH_USER_ORIGIN=http://127.0.0.1:3100
AUTH_ADMIN_ORIGIN=http://127.0.0.1:3101
AUTH_SECURE_COOKIES=false
# Required only when AUTH_ENABLED=true; keep these in .secrets/.
# AUTH_USER_SECRET_FILE=.secrets/auth_user_secret
# AUTH_ADMIN_SECRET_FILE=.secrets/auth_admin_secret
# Optional controlled bootstrap secret for creating the two boss accounts; it has no default
# and must differ from both Better Auth secrets.
# AUTH_ADMIN_BOOTSTRAP_SECRET_FILE=.secrets/admin_bootstrap_secret

# Business migration is a separate execution purpose. It targets an explicitly named
# local profile and uses a separate DDL role; it must never reuse DB_USER as its role.
# APP_PROFILE=migration
# MIGRATION_TARGET_PROFILE=dev
# MIGRATION_TARGET_DB_NAME=zzsh_dev
# MIGRATION_DB_USER=zzsh_migration
# MIGRATION_DB_PASSWORD_FILE=.secrets/migration_password
# MIGRATION_RUNTIME_USER=zzsh_runtime

# provider-test only; this is a scope label, not channel authorization.
# PROVIDER_TEST_SCOPE=local-fake

# Media storage selection is independent of PROVIDER_MODE. "local" (default)
# keeps content-addressed files under ./uploads; "oss" requires the OSS_*
# target variables below plus server-side ALIBABA_CLOUD_ACCESS_KEY_ID /
# ALIBABA_CLOUD_ACCESS_KEY_SECRET (optional ALIBABA_CLOUD_SECURITY_TOKEN) from
# the process environment — never from this file, the browser or the frontend.
# MEDIA_STORAGE=oss
# OSS_BUCKET=zzsh-dev
# OSS_REGION=oss-cn-shenzhen
# OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
# OSS_OBJECT_PREFIX=zzsh-rebuild/dev/

# ecs-test is reserved for a separately reviewed real target and is currently
# fail-closed. Do not set APP_PROFILE=ecs-test in local development.

# Server-only disaster recovery test contract. Never enable this in dev/provider-test
# or production; the command requires APP_PROFILE=test, a local isolated test DB,
# PROVIDER_MODE=fake, and a non-owner runtime role. The target submits only the
# SHA-256 digest; the usable credential stays on the target side and is never
# printed or read by the command.
# M2_DISASTER_RECOVERY_ENABLED=true
# M2_DISASTER_RECOVERY_TARGET_ADMIN_ID=admin_<test-id>
# M2_DISASTER_RECOVERY_OPERATOR_ID=deployment-maintainer_<test-id>
# M2_DISASTER_RECOVERY_OFFLINE_CONFIRMATION_ID=offline-confirmation_<test-id>
# M2_DISASTER_RECOVERY_TARGET_CREDENTIAL_HASH_FILE=.secrets/disaster_recovery_target_credential_hash
