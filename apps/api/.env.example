# 仅本地联调示例；npm dev/start显式加载.env。部署使用.env.deployment.example，由服务管理器注入。
APP_PROFILE=dev
PROVIDER_MODE=fake
DB_TARGET=local-compose
HOST=127.0.0.1
PORT=3102
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=zzsh_dev_daily
DB_USER=zzsh_daily_r
DB_PASSWORD_FILE=.secrets/postgres_runtime_password
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_PASSWORD_FILE=.secrets/redis_password

# 正常启动运行认证；先安装schema/ACL，使用登记的非owner runtime身份。
# 隔离health-only夹具可显式关闭，部署环境不能以此省略认证。
AUTH_ENABLED=true
AUTH_API_ORIGIN=http://127.0.0.1:3102
AUTH_USER_ORIGIN=http://127.0.0.1:3100
AUTH_ADMIN_ORIGIN=http://127.0.0.1:3101
AUTH_SECURE_COOKIES=false
# Required only when AUTH_ENABLED=true; keep these in .secrets/.
# AUTH_USER_SECRET_FILE=.secrets/auth_user_secret
# Stable identity-only key shared by verification and legacy import; do not rotate with auth secrets.
# USER_IDENTITY_SUBJECT_HMAC_KEY_FILE=.secrets/user_identity_subject_hmac
# Independent 32-byte base64url key for encrypted legacy identity profiles.
# USER_LEGACY_IDENTITY_PROFILE_KEY_FILE=.secrets/user_legacy_identity_profile_key
# 部署环境自动装配正式结算；仍须准确的服务端收款/资源准入，不接受客户端宣称成功。
# Explicit user channels. These do not enable funds or reuse MEDIA_STORAGE credentials.
USER_SMS_PROVIDER=disabled
# USER_SMS_SIGN_NAME=APPROVED_SIGN
# USER_SMS_TEMPLATE_CODE=SMS_APPROVED_TEMPLATE
# USER_SMS_ACCESS_KEY_ID_FILE=.secrets/user_sms_access_key_id
# USER_SMS_ACCESS_KEY_SECRET_FILE=.secrets/user_sms_access_key_secret
# USER_SMS_SECURITY_TOKEN_FILE=.secrets/user_sms_security_token
USER_REAL_NAME_PROVIDER=disabled
# Mandatory explicit cost controls before real verification is enabled; no implicit published policy.
# USER_REAL_NAME_DAILY_LIMIT=OWNER_APPROVED_POSITIVE_INTEGER
# USER_REAL_NAME_MIN_INTERVAL_SECONDS=OWNER_APPROVED_POSITIVE_INTEGER
# USER_REAL_NAME_ACCESS_KEY_ID_FILE=.secrets/user_real_name_access_key_id
# USER_REAL_NAME_ACCESS_KEY_SECRET_FILE=.secrets/user_real_name_access_key_secret
# USER_REAL_NAME_SECURITY_TOKEN_FILE=.secrets/user_real_name_security_token
# AUTH_ADMIN_SECRET_FILE=.secrets/auth_admin_secret
# Optional controlled bootstrap secret for creating the two boss accounts; it has no default
# and must differ from both Better Auth secrets.
# AUTH_ADMIN_BOOTSTRAP_SECRET_FILE=.secrets/admin_bootstrap_secret

# Admin brute-force protection (always on, any NODE_ENV).
# Client IP: X-Forwarded-For is ignored unless the socket peer is in ADMIN_TRUSTED_PROXIES
# (comma-separated IPs, IPv4 CIDRs or "loopback"); then ADMIN_CLIENT_IP_HEADER is read
# (x-forwarded-for | x-real-ip, default x-forwarded-for, right-most untrusted hop).
# ADMIN_TRUSTED_PROXIES=loopback
# ADMIN_CLIENT_IP_HEADER=x-real-ip
# Self-hosted ALTCHA HMAC key (>=32 chars). Required in production; outside production a
# random per-process key is generated in memory when unset.
# ADMIN_ALTCHA_HMAC_KEY=

# Business migration is a separate execution purpose. It targets an explicitly named
# local profile and uses a separate DDL role; it must never reuse DB_USER as its role.
# APP_PROFILE=migration
# MIGRATION_TARGET_PROFILE=dev
# MIGRATION_TARGET_DB_NAME=zzsh_dev
# MIGRATION_DB_USER=zzsh_migration
# MIGRATION_DB_PASSWORD_FILE=.secrets/migration_password
# MIGRATION_RUNTIME_USER=zzsh_runtime

# provider-test only; this is a scope label, not channel authorization.
# PROVIDER_TEST_SCOPE=local-fake

# Yunxin NIM. A deployed target always runs real IM: filling YUNXIN_APP_KEY plus
# YUNXIN_APP_SECRET(_FILE) enables the provider on its own. Leave both unset to
# keep the API fully offline (no provider assembly, no IM credentials issued) —
# every offline test run relies on that. YUNXIN_ENABLED=false only exists to force
# it off while credentials are present, and is rejected in APP_PROFILE=migration.
# Never put secrets in this file; use a local ignored .secrets file.
# YUNXIN_ENABLED=true
# YUNXIN_APP_KEY=your-dev-app-key
# YUNXIN_APP_SECRET_FILE=.secrets/yunxin_app_secret

# Media storage selection is independent of PROVIDER_MODE. "local" (default)
# keeps content-addressed files under ./uploads; "oss" requires the OSS_*
# target variables below plus server-side ALIBABA_CLOUD_ACCESS_KEY_ID /
# ALIBABA_CLOUD_ACCESS_KEY_SECRET (optional ALIBABA_CLOUD_SECURITY_TOKEN) from
# the process environment — never from this file, the browser or the frontend.
# MEDIA_STORAGE=oss
# OSS_BUCKET=zzsh-dev
# OSS_REGION=oss-cn-shenzhen
# OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
# OSS_OBJECT_PREFIX=zzsh-rebuild/dev/
# Account image direct upload and signed previews remain disabled until the
# private bucket CNAME, permissions, and CORS have been checked in isolation.
# OSS_ACCOUNT_MEDIA_DIRECT=0
# OSS_ACCOUNT_MEDIA_BROWSER_ORIGIN=https://private-images.example.com
# Admin content storage status is read-only. A successful sample read does not
# verify uploads/CDN. Keep the bucket private; see docs/architecture/content-management.md.

# ecs-test/production需要独立目标、验证证书的TLS和完整部署配置；不得改本机库名冒充云上资源。

# Server-only disaster recovery test contract. Never enable this in dev/provider-test
# or production; the command requires APP_PROFILE=test, a local isolated test DB,
# PROVIDER_MODE=fake, and a non-owner runtime role. The target submits only the
# SHA-256 digest; the usable credential stays on the target side and is never
# printed or read by the command.
# M2_DISASTER_RECOVERY_ENABLED=true
# M2_DISASTER_RECOVERY_TARGET_ADMIN_ID=admin_<test-id>
# M2_DISASTER_RECOVERY_OPERATOR_ID=deployment-maintainer_<test-id>
# M2_DISASTER_RECOVERY_OFFLINE_CONFIRMATION_ID=offline-confirmation_<test-id>
# M2_DISASTER_RECOVERY_TARGET_CREDENTIAL_HASH_FILE=.secrets/disaster_recovery_target_credential_hash

# Local dev/test only; request a code first, then enter 888888. Never sends SMS.
# 可选：v3 4/5/6 详情准入 manifest（仅 APP_PROFILE=test 且非 production）。
# manifest 与分片都必须位于 .secrets 内；列表仍使用原 status3 单文件准入。
# LEGACY_PUBLIC_ADMISSION_MANIFEST=.secrets/legacy-v3-admission/manifest.json

AUTH_LOCAL_SMS_MOCK=false

# Standard authenticated startup releases expired unpaid holds in bounded batches.
# Isolated createApp fixtures do not start this worker unless explicitly composed.
# ORDER_SWEEP_ENABLED=false

# 部署环境的成长/信用/分销不逐模块开关；仍核已发布政策、完整主体与schema/ACL。
# 本地隔离夹具可以用旧业务开关，不能把缺政策/未知权益变成零减免。

# User auth base limits are separate from the unpublished proposal.
USER_AUTH_THROTTLE_MODE=base
# memory is single-process development/fixture storage; postgres shares counters.
# postgres需要已装正式迁移与准确runtime ACL；失败不回退memory。
USER_AUTH_THROTTLE_STORE=memory
# Required for production or postgres; independent of both auth secrets.
# USER_AUTH_THROTTLE_HMAC_KEY_FILE=.secrets/user_auth_throttle_hmac
# Configure the API AND the Next server. Only after verifying private Next/API ingress,
# stripped forwarded headers and the actual edge may socketless Next assert this.
USER_EDGE_ASSURED=false
USER_TRUSTED_PROXIES=
# Production protected auth writes without a verified non-loopback client IP return safe 503.
# They do not fall into a shared unknown-IP bucket. Local fixtures may opt out in code.
