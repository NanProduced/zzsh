{
  "name": "@zzsh/content",
  "version": "0.0.0",
  "private": true,
  "main": "index.cjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.cjs"
    },
    "./updates": {
      "types": "./updates.d.ts",
      "default": "./updates.cjs"
    },
    "./plate": {
      "types": "./plate-schema.d.mts",
      "default": "./plate-schema.mjs"
    },
    "./legacy-plate": {
      "types": "./legacy-plate.d.ts",
      "default": "./legacy-plate.mjs"
    }
  },
  "scripts": {
    "test": "node --test test/content.test.mjs test/updates.test.mjs test/plate-schema.test.mjs test/plate-defaults-manifest.test.mjs"
  },
  "dependencies": {
    "unified": "11.0.5",
    "remark-parse": "11.0.0",
    "remark-gfm": "4.0.1",
    "mdast-util-to-string": "4.0.0"
  }
}
