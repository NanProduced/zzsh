{
  "name": "zzsh",
  "version": "0.0.0",
  "private": true,
  "description": "洲洲商行重建 monorepo",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "local:auth": "node scripts/local-auth.mjs",
    "local:admin": "node scripts/local-auth.mjs",
    "migration:rehearsal": "node scripts/migration/legacy-rehearsal.mjs",
    "test:migration-rehearsal": "node --experimental-test-module-mocks --test scripts/migration/legacy-rehearsal.test.mjs scripts/migration/local-contact-append.test.mjs scripts/migration/local-funds-plan.test.mjs scripts/migration/local-round-recovery.test.mjs scripts/migration/local-continuation-plan.test.mjs scripts/migration/local-round-output.test.mjs scripts/migration/local-target-registry.test.mjs scripts/migration/selected-business-scope.test.mjs scripts/migration/full-source-scope.test.mjs scripts/migration/local-source-scenarios.test.mjs scripts/migration/capture-legacy-account-extra.test.mjs scripts/migration/legacy-listed-round-source.test.mjs scripts/migration/legacy-listed-execution-plan.test.mjs scripts/migration/legacy-listed-provisional-credit.test.mjs scripts/migration/readback-empty-legacy-listed.test.mjs scripts/migration/legacy-listed-policy-postgres.test.mjs scripts/migration/verify-legacy-listed-policy-dump.test.mjs scripts/migration/local-legacy-bank-runner.test.mjs scripts/migration/local-empty-bank-postgres.test.mjs scripts/migration/local-finance-target-postgres.test.mjs scripts/migration/local-legal-pair.test.mjs scripts/migration/local-round-dependencies.test.mjs scripts/migration/stage-round07-dependencies.test.mjs scripts/migration/prepare-round07-inputs.test.mjs scripts/migration/prepare-round07-postgres.test.mjs scripts/migration/prepare-local-mysql-source.test.mjs scripts/migration/run-local-source-workflow.test.mjs scripts/migration/register-round07-target.test.mjs scripts/migration/install-round07-schema.test.mjs scripts/migration/readback-round07-bootstrap.test.mjs scripts/migration/seal-round07-maintenance-binding.test.mjs scripts/migration/initialize-local-policy.test.mjs scripts/migration/bootstrap-local-reference.test.mjs scripts/migration/business-reference-readiness-postgres.test.mjs scripts/migration/local-invitation-counts.test.mjs scripts/migration/local-legacy-bank-source.test.mjs scripts/migration/local-legacy-bank-source-mysql.test.mjs scripts/migration/local-credit-initialization-plan.test.mjs scripts/migration/local-distribution-qualification-plan.test.mjs scripts/migration/local-distribution-workflow.test.mjs scripts/migration/local-distribution-qualification-runner.test.mjs scripts/migration/local-distribution-qualification-readback.test.mjs scripts/migration/local-distribution-policy-approval.test.mjs scripts/migration/local-distribution-policy-runtime.test.mjs scripts/migration/local-distribution-transaction-postgres.test.mjs scripts/migration/local-distribution-security-contract.test.mjs scripts/migration/local-growth-plan.test.mjs scripts/migration/local-growth-packages.test.mjs scripts/migration/local-growth-transaction-postgres.test.mjs scripts/migration/local-growth-lookup-postgres.test.mjs scripts/migration/local-growth-scope.test.mjs scripts/migration/listed-batch-workflow.test.mjs scripts/migration/local-target-display.test.mjs scripts/migration/local-target-holdings.test.mjs scripts/migration/local-target-opening.test.mjs scripts/migration/local-empty-coverage.test.mjs scripts/migration/business-initial-notes.test.mjs scripts/migration/business-initial-seeds.test.mjs scripts/migration/business-initial-tail-seeds.test.mjs scripts/migration/business-initial-tail-seeds-postgres.test.mjs scripts/migration/approved-migration-release.test.mjs scripts/migration/prepare-local-distribution.test.mjs scripts/migration/prepare-round07-distribution-candidate.test.mjs scripts/migration/round-distribution-preflight.test.mjs scripts/migration/prepare-legacy-path-source.test.mjs scripts/migration/prepare-local-legacy-bank-input.test.mjs scripts/migration/run-local-credit-initialization.test.mjs scripts/migration/complete-round07-listed-holdings.test.mjs scripts/migration/complete-round07-history-holdings.test.mjs",
    "test:distribution-owner-tools": "node --test scripts/distribution-reversal-declare.test.mjs scripts/distribution-pg-native-acceptance.test.mjs",
    "test:local-auth": "node --test scripts/local-auth.test.mjs scripts/assert-offline-env.test.mjs scripts/smoke.test.mjs scripts/ci-scope.test.mjs",
    "dev": "concurrently --kill-others --names api,web,admin \"npm run dev -w @zzsh/api\" \"npm run dev -w @zzsh/web\" \"npm run dev -w @zzsh/admin\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @zzsh/api",
    "test:smoke": "node scripts/smoke.mjs",
    "check:offline": "node scripts/assert-offline-env.mjs && node scripts/check-test-entries.mjs && npm run test:local-auth && npm run test:distribution-owner-tools && npm run test:content && npm run test:ui:shared && npm run build && npm run typecheck -w @zzsh/web && npm run test:compiled -w @zzsh/api && npm run test:web && npm run test:ui -w @zzsh/web && npm run test:admin && npm run test:production -w @zzsh/web && npm run test:smoke",
    "test:web": "npm test -w @zzsh/web",
    "check": "npm run check:offline && npm run test:db:compiled -w @zzsh/api",
    "test:admin": "npm test -w @zzsh/admin",
    "test:content": "npm test -w @zzsh/content",
    "test:ui:shared": "npm test -w @zzsh/ui"
  },
  "devDependencies": {
    "@types/node": "24.5.0",
    "concurrently": "10.0.5",
    "typescript": "5.9.3"
  }
}
